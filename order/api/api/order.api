syntax = "v1"

info (
	title:   "type title here"
	desc:    "type desc here"
	author:  "type author here"
	email:   "type email here"
	version: "type version here"
)

type EmptyResp {}

type CreateOrderReq {
	GoodsIds        []string `json:"goodsIds"`
	ReceiverName    string   `json:"receiverName"`
	ReceiverPhone   string   `json:"receiverPhone"`
	ReceiverAddress string   `json:"receiverAddress"`
	Remark          *string  `json:"remark"`
}

type CreateOrderResp {
	OrderNo string `json:"orderNo"`
}

type OrderItemVO {
	GoodsId       string `json:"goodsId"`
	GoodsName     string `json:"goodsName"`
	GoodsCover    string `json:"goodsCover"`
	GoodsSpec     string `json:"goodsSpec"` //商品规格
	GoodsPrice    string `json:"goodsPrice"` //下单快照单价
	GoodsNum      int64  `json:"goodsNum"` //购买数量
	SubtotalPrice string `json:"subtotalPrice"` //单行商品小计 =单价*数量（优惠前）
}

type OrderPreviewReq {
	GoodsIds []string `json:"goodsIds"`
}

type OrderPreviewResp {
	ReceiverName    string           `json:"receiverName"`
	ReceiverPhone   string           `json:"receiverPhone"`
	ReceiverAddress string           `json:"receiverAddress"`
	TotalAmount     string           `json:"totalAmount"`
	PayAmount       string           `json:"payAmount"`
	ItemList        []*PreviewItemVO `json:"itemList"`
}

type PreviewItemVO {
	GoodsId       string `json:"goodsId"`
	GoodsName     string `json:"goodsName"`
	GoodsCover    string `json:"goodsCover"`
	GoodsPrice    string `json:"goodsPrice"` //单品单价，string存decimal
	GoodsNum      int64  `json:"goodsNum"` //购买数量
	SubtotalPrice string `json:"subtotalPrice"` //该商品小计
}

type OrderOffReq {
	OrderNo string `json:"orderNo"`
}

type PayOrderReq {
	OrderNo string `json:"orderNo"`
}

@server (
	jwt: Auth
)
service order {
	@handler createOrder
	post /order (CreateOrderReq) returns (CreateOrderResp)

	@handler previewOrder
	post /order/preview (OrderPreviewReq) returns (OrderPreviewResp)

	@handler offOrder
	patch /order/off (OrderOffReq) returns (EmptyResp)

	@handler payOrder
	post /order/pay (PayOrderReq) returns (EmptyResp)
}

